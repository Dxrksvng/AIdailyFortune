 poc/templates/request_letter_th.html |  1 +
 poc/tests/test_hostile_values.py     | 30 +++++++++++
 poc/tests/test_renderer_network.py   | 48 +++++++++++++++++
 4 files changed, 131 insertions(+), 29 deletions(-)
 create mode 100644 poc/tests/test_hostile_values.py
 create mode 100644 poc/tests/test_renderer_network.py

