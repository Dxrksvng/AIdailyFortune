+def load_source(tag: str, path: Path) -> str:
+    """Markdown of one answer. For A3, section 3.4 is replaced by the full user guide so the PDF is one self-contained file."""
+    md = path.read_text(encoding="utf-8")
+    if tag != "A3":
+        return md
+    guide = (path.parent / "USER_GUIDE.md").read_text(encoding="utf-8")
+    guide = re.sub(r"^# [^\n]*\n", "", guide, count=1)          # drop the guide's own H1
+    guide = re.sub(r"(?m)^(#{2,4}) ", lambda m: "#" * (len(m.group(1)) + 1) + " ", guide)   # demote headings one level
+    m = re.search(r"## 3\.4 [^\n]*\n(.*?)(?=\n## )", md, re.S)
+    tail = re.search(r"(สิ่งที่ตรวจแล้วเกี่ยวกับคู่มือ.*)", m.group(1), re.S).group(1)   # keep the verified / not-done paragraphs
+    lead = ("คู่มือสำหรับพนักงานอายุราว 35 ถึง 40 ปีที่คุ้นเคย Microsoft Office, Google Workspace และอีเมล "
+            "ฉบับเต็มอยู่ด้านล่างในไฟล์นี้ ภาพหน้าจอเป็นภาพตัวอย่าง (mockup) เพราะระบบยังเป็นข้อเสนอ\n\n")
+    return md[:m.start()] + "## 3.4 คู่มือผู้ใช้\n\n" + lead + guide.strip() + "\n\n---\n\n" + tail.strip() + "\n" + md[m.end():]
+
+
+def collect_confirms_md(sources) -> list[tuple[str, str]]:
+    """(heading, text) for every [TO CONFIRM...] marker, read from the Markdown source.
+
+    Each entry is the whole table cell or up to 18 words before the marker, cut at a word boundary.
+    Markers inside code fences (the example Definition files) are summarised as one entry per heading.
+    """
+    found: list[tuple[str, str]] = []
+    for tag, path in sources:
+        heading, in_fence, fence_count, prev = tag, False, {}, ""
+        for line in load_source(tag, path).splitlines():
+            if line.strip() and not in_fence and "[TO CONFIRM" not in line:
+                prev = re.sub(r"\*\*|`", "", line).strip()
+            if line.lstrip().startswith("```"):
+                in_fence = not in_fence
+                continue
+            if "[TO CONFIRM" not in line:
+                if re.match(r"#{1,3} ", line):
+                    heading = f"{tag}: " + re.sub(r"\s*\[(?:TO CONFIRM[^\]]*|ข้อเสนอ|ทดสอบแล้ว|ออกแบบ)\]", "", line.lstrip("# ").replace("**", "").strip()).strip()
+                continue
+            if re.match(r"#{1,3} ", line):
+                heading = f"{tag}: " + re.sub(r"\s*\[(?:TO CONFIRM[^\]]*|ข้อเสนอ|ทดสอบแล้ว|ออกแบบ)\]", "", line.lstrip("# ").replace("**", "").strip()).strip()
+                continue
+            if in_fence:
+                fence_count[heading] = fence_count.get(heading, 0) + line.count("[TO CONFIRM")
+                continue
+            clean = re.sub(r"\*\*|`", "", line)
+            clean = re.sub(r"^\s*(?:>\s*)+", "", clean)
+            clean = re.sub(r"^\s*(?:[-+*]|\d+\.)\s+(?:\[[ xX]\]\s+)?", "", clean)
+            clean = re.sub(r"\[([^\]]+)\]\((?!https?://)[^)]*\)", r"\1", clean)
+            cells = [c.strip() for c in clean.split("|")] if clean.lstrip().startswith("|") else [clean.strip()]
+            for cell in cells:
+                if "[TO CONFIRM" not in cell:
+                    continue
+                tokens = cell.split()
+                first = next(i for i, tok in enumerate(tokens) if "[TO" in tok)
+                last = first
+                while last < len(tokens) - 1 and "]" not in tokens[last]:
+                    last += 1
+                entry = " ".join(tokens[max(0, first - 18): last + 1])
+                if first == 0 and prev:  # marker opens the line: take the end of the previous line for context
+                    entry = " ".join(prev.split()[-14:]) + " " + entry
+                if (heading, entry) not in found:
+                    found.append((heading, entry))
+        for heading, n in fence_count.items():
+            found.append((heading, f"ในไฟล์ Definition ตัวอย่าง (ส่วนโค้ด) มีเครื่องหมาย [TO CONFIRM] {n} จุด"))
+    return found
+
